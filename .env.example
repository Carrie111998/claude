# Copy this to .env and fill in your values

# OmniRoute API Configuration
# Multiple endpoints available for different access methods
OMNIROUTE_API_KEY=your_api_key_here
OMNIROUTE_ENDPOINT=public

# Endpoint Options (public, cloudflare, local, network):
# - public: https://omniroute-0lvo.srv1854512.hstgr.cloud/v1
# - cloudflare: https://occasions-idol-increasingly-tested.trycloudflare.com/v1
# - local: http://localhost:20128/v1
# - network: http://172.16.1.2:20128/v1
# Default endpoints configured in app/config.py

# Optional: MCP SSE endpoint
# OMNIROUTE_MCP_SSE=https://omniroute-0lvo.srv1854512.hstgr.cloud/api/mcp/sse

# Application Configuration
DEBUG=false
